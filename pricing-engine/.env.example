# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kicknap

# Email (Zoho Mail or SMTP)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=pricing@kicknap.com
SMTP_PASS=your_password_here
EMAIL_FROM=pricing@kicknap.com

# Airbnb scraping
SCRAPE_DELAY_SECONDS=3
MAX_PAGES=5

# Pricing thresholds
PRICE_CHANGE_THRESHOLD=0.10  # notify host if price changes >10%

# kicknap fees
GUEST_FEE_PERCENT=0.10
HOST_FEE_PERCENT=0.03
